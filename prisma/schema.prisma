// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

// Better Auth User Model
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

// Better Auth Account Model
model Account {
  id            String    @id @default(cuid())
  accountId     String
  providerId    String
  userId        String
  accessToken   String?
  refreshToken  String?
  idToken       String?
  expiresAt     DateTime?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Better Auth Session Model
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// Better Auth Verification Model
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verification")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Property {
  id            String         @id @default(cuid())
  // Language-specific fields
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  // Basic property fields
  price         Float
  type          PropertyType
  status        PropertyStatus @default(AVAILABLE)
  city          String
  district      String?
  bedrooms      Int
  bathrooms     Int
  area          Int
  parking       Int            @default(0)
  features      String[]
  images        String[]
  // Property features
  yearBuilt     Int?
  floors        Int            @default(1)
  furnished     Boolean        @default(false)
  petFriendly   Boolean        @default(false)
  balcony       Boolean        @default(false)
  garden        Boolean        @default(false)
  pool          Boolean        @default(false)
  gym           Boolean        @default(false)
  security      Boolean        @default(false)
  elevator      Boolean        @default(false)
  // Contact information
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("properties")
}

enum PropertyType {
  APARTMENT
  VILLA
  OFFICE
  SHOP
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  SOLD
}

model Post {
  id          String     @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  headerImage String?
  thumbnail   String?
  status      PostStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("posts")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Contact {
  id          String   @id @default(cuid())
  name        String
  phoneNumber String
  message     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contacts")
}

model SiteSettings {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model AboutPage {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about_page")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String
  features    String[]
  order       Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model ServicesPage {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  heroImage String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services_page")
}

model AboutSettings {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about_settings")
}

model ContactSettings {
  id             String   @id @default(cuid())
  phoneNumber    String   @default("+966501234567")
  whatsappNumber String   @default("966501234567")
  showPhone      Boolean  @default(true)
  showWhatsApp   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("contact_settings")
}