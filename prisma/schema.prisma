// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

// FILE: prisma/schema.prisma
// Make sure this matches exactly - no duplicate definitions

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}



// ... rest of your models

 

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
 
model Property {
  id          String   @id @default(cuid())
  // Language-specific fields
  titleEn     String
  titleAr     String
  descriptionEn String?
  descriptionAr String?
  // Basic property fields
  price       Float
  type        PropertyType
  status      PropertyStatus @default(AVAILABLE)
  city        String
  district    String?
  bedrooms    Int
  bathrooms   Int
  area        Int
  parking     Int @default(0)
  features    String[]
  images      String[]
  
  // Property features (only keeping what's used in PropertyDetailPage)
  yearBuilt   Int?
  floors      Int @default(1)
  furnished   Boolean @default(false)
  petFriendly Boolean @default(false)
  balcony     Boolean @default(false)
  garden      Boolean @default(false)
  pool        Boolean @default(false)
  gym         Boolean @default(false)
  security    Boolean @default(false)
  elevator    Boolean @default(false)
  
  // Contact information
  contactName String?
  contactPhone String?
  contactEmail String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("properties")
}

enum PropertyType {
  APARTMENT
  VILLA
  OFFICE
  SHOP
}

enum PropertyStatus {
  AVAILABLE
  RENTED
  SOLD
}

model Post {
  id          String   @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  headerImage String?
  thumbnail   String?
  status      PostStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("posts")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}


model Contact {
  id          String   @id @default(cuid())
  name        String
  phoneNumber String
  message     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contacts")
}

// Single-row JSON-backed site settings
model SiteSettings {
  id        String   @id // use a stable id like "default"
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// About page content stored as JSON
model AboutPage {
  id        String   @id // use a stable id like "default"
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about_page")
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  image       String
  features    String[] // Array of features
  order       Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("services")
}

model ServicesPage {
  id        String   @id @default(cuid())
  title     String
  subtitle  String
  heroImage String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("services_page")
}

// About settings content stored as JSON
model AboutSettings {
  id        String   @id // use a stable id like "default"
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about_settings")
}


model ContactSettings {
  id             String   @id @default(cuid())
  phoneNumber    String   @default("+966501234567")
  whatsappNumber String   @default("966501234567")
  showPhone      Boolean  @default(true)
  showWhatsApp   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("contact_settings")
}